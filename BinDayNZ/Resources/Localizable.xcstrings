    "Bins with lids that don't close won't be collected.": {
      "extractionState": "stale",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन बिन के ढक्कन बंद नहीं होते, उन्हें नहीं उठाया जाएगा।"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뛰껍이 닫히지 않는 쓰레기통은 수거되지 않습니다."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāore e kohia ngā ipu kāore e kati te taupoki."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "盖子无法关闭的垃圾桶不会被收集。"
          }
        }
      }
    },
