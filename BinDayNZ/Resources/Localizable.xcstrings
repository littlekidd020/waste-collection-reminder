    "Bin Day": {
      "comment": "Product branding; keep this text unchanged in every language.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin Day"
          }
        }
      },
      "shouldTranslate": false
    },
    "Bin Day NZ could not open its saved information. Free some device storage and reopen the app. Your data has not been reset. Use Privacy and Help for support.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin Day NZ could not open its saved information. Free some device storage and reopen the app. Your data has not been reset. Use Privacy and Help for support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin Day NZ 无法打开已保存的信息。请释放一些设备存储空间后重新打开应用。您的数据尚未重置。如需支持，请查看“隐私和帮助”。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāore a Bin Day NZ i āhei ki te huaki i ngā mōhiohio kua tiakina. Whakawāteatia ētahi wāhi rokiroki, ka huaki anō i te taupānga. Kāore ō raraunga i tautuhi anō. Whakamahia Matatapu me te āwhina mō te tautoko."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin Day NZ가 저장된 정보를 열 수 없습니다. 기기 저장 공간을 확보한 뒤 앱을 다시 여세요. 데이터는 초기화되지 않았습니다. 지원은 ‘개인정보 및 도움말’을 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin Day NZ सहेजी हुई जानकारी नहीं खोल सका। डिवाइस में कुछ जगह खाली करके ऐप फिर खोलें। आपका डेटा रीसेट नहीं किया गया है। सहायता के लिए ‘गोपनीयता और सहायता’ देखें।"
          }
        }
      }
    },
    "Bin Day NZ shows the schedule you saved. The source for your property's collection dates is %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin Day NZ shows the schedule you saved. The source for your property's collection dates is %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin Day NZ 显示您保存的收集安排。您房产收集日期的来源是%@。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka whakaatu a Bin Day NZ i te hōtaka i tiakina e koe. Ko %@ te puna mō ngā rā kohinga o tō whare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin Day NZ는 저장한 일정을 보여줍니다. 귀하의 주택 수거 날짜의 출처는 %@입니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin Day NZ आपका सहेजा गया कार्यक्रम दिखाता है। आपकी संपत्ति की संग्रह तारीखों का स्रोत %@ है।"
          }
        }
      }
    },
    "Bin Day NZ shows the schedule you saved. Your council's website is the source for your property's collection dates.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin Day NZ shows the schedule you saved. Your council's website is the source for your property's collection dates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin Day NZ 显示您保存的收集安排。您所在议会的网站是您房产收集日期的来源。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka whakaatu a Bin Day NZ i te hōtaka i tiakina e koe. Ko te paetukutuku a tō kaunihera te puna mō ngā rā kohinga o tō whare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin Day NZ는 저장한 일정을 보여줍니다. 귀하의 주택 수거 날짜의 출처는 해당 의회 웹사이트입니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin Day NZ आपका सहेजा गया कार्यक्रम दिखाता है। आपकी काउंसिल की वेबसाइट आपकी संपत्ति की संग्रह तारीखों का स्रोत है।"
          }
        }
      }
    },
    "Book an inorganic collection": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Book an inorganic collection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约大件垃圾收集"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tāpuitia he kohinga kore-koiora"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대형 폐기물 수거 예약"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अकार्बनिक संग्रह बुक करें"
          }
        }
      }
    },
    "Book with Auckland Council": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Book with Auckland Council"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向奥克兰市议会预约"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tāpuitia ki Te Kaunihera o Tāmaki Makaurau"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오클랜드 시의회에 예약"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑकलैंड काउंसिल के साथ बुक करें"
          }
        }
      }
    },
    "Book with Auckland Council first. Items are collected from inside your property boundary, not the kerbside.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Book with Auckland Council first. Items are collected from inside your property boundary, not the kerbside."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先向奥克兰市议会预约。物品从您房产边界内收集，而不是从路边收集。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Me tāpui ki Te Kaunihera o Tāmaki Makaurau i te tuatahi. Ka kohia ngā taonga i roto i ngā rohe o tō whenua, kaua i te taha rori."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 오클랜드 시의회에 예약하세요. 물품은 도로변이 아닌 사유지 경계 안에서 수거합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले ऑकलैंड काउंसिल के साथ बुक करें। सामान आपकी संपत्ति की सीमा के अंदर से उठाया जाता है, सड़क के किनारे से नहीं।"
          }
        }
      }
    },
    "Booked collection": {
      "comment": "Small uppercase eyebrow above 'Inorganic Collection' on the Guide: this service is booked, not on a regular schedule",
