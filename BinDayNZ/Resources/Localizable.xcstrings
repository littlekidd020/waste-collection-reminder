    "%@ is %@. Auckland Council: a collection on or after a public holiday runs one day later that week.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is %@. Auckland Council: a collection on or after a public holiday runs one day later that week."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是 %@。奥克兰市议会：公共假日当天或之后的收集在该周顺延一天。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko %@ hei te %@. Auckland Council: ka whakaroa te kohinga i te rā hararei, i muri rānei, kia kotahi rā i taua wiki."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) %@입니다. 오클랜드 시의회: 공휴일 당일 또는 그 이후의 수거는 그 주에 하루 늦게 진행됩니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ को है। ऑकलैंड काउंसिल: सार्वजनिक छुट्टी के दिन या उसके बाद का संग्रह उस सप्ताह एक दिन देर से होता है।"
          }
        }
      }
    },
    "%@ moves from %@ to %@": {
