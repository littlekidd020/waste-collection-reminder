            "state": "translated",
            "value": "अपने परिवार के साथ साझा करें"
          }
        }
      }
    },
    "Everyone on your street has the same bin days. Send your schedule so they can add it in one tap.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone on your street has the same bin days. Send your schedule so they can add it in one tap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一条街的邻居收集日相同。把您的日程发给他们，一键即可添加。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "He ōrite ngā rā ipu para o te katoa i tō tiriti. Tukuna tō rārangi wā kia tāpiri ai rātou mā te pā kotahi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 거리의 이웃은 수거일이 같습니다. 일정을 보내면 한 번의 탭으로 추가할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सड़क पर सबके कचरा दिन एक जैसे हैं। अपना शेड्यूल भेजें ताकि वे एक टैप में जोड़ सकें।"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāore i tēnei wā"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에"
          }
        },
        "hi": {
