          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 켜짐 · %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुस्मारक चालू · %@"
          }
        }
      }
    },
    "Reminders paused until %@": {
      "comment": "Quiet status line on Today while reminders are paused: %@ is a date such as '16 November'.",
      "localizations": {
        "en": {
          "stringUnit": {
