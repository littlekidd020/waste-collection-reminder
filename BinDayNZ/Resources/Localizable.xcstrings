    "Move or skip one collection. The regular weekly or fortnightly cycle stays the same.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move or skip one collection. The regular weekly or fortnightly cycle stays the same."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动或跳过一次收集。常规的每周或每两周周期保持不变。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekehia, tīpaohia rānei tētahi kohinga kotahi. Ka mau tonu te huringa auau ā-wiki, ā-rua wiki rānei."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 수거를 옮기거나 건너뜁니다. 매주 또는 격주 정기 주기는 유지됩니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक संग्रह को आगे-पीछे करें या छोड़ें। नियमित साप्ताहिक या हर दो सप्ताह का चक्र वैसा ही रहता है।"
          }
        }
      }
    },
