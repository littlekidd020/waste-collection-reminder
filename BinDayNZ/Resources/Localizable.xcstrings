    "Garden waste collections are often optional and may need a subscription with your council.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Garden waste collections are often optional and may need a subscription with your council."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "园林垃圾收集通常是可选的，可能需要向议会订购。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "He kōwhiringa noa ngā kohinga para māra i te nuinga o te wā, ā, me ohauru pea ki tō kaunihera."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정원 쓰레기 수거는 대개 선택 사항이며 의회에 신청이 필요할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बगीचे के कचरे का संग्रह अक्सर वैकल्पिक होता है और इसके लिए काउंसिल से सदस्यता लेनी पड़ सकती है।"
          }
        }
      }
    },
