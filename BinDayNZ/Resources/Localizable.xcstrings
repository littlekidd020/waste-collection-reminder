    },
    "Reminder times stay in New Zealand time, including when you travel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder times stay in New Zealand time, including when you travel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使您在旅行，提醒仍采用新西兰时间。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka noho ngā wā whakamahara ki te wā o Aotearoa, ahakoa kei te haere koe ki tāwāhi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행 중에도 알림은 뉴질랜드 시간을 유지합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यात्रा के दौरान भी अनुस्मारक न्यूज़ीलैंड समय पर ही रहते हैं।"
          }
        }
      }
    },
    "Reminder: %@": {
