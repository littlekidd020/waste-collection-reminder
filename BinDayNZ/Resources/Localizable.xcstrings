    "Flat paper and cardboard must be larger than 10 × 14 cm. On Aotea, bundle paper and cardboard beside your recycling crate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flat paper and cardboard must be larger than 10 × 14 cm. On Aotea, bundle paper and cardboard beside your recycling crate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平整的纸张和纸板必须大于10 × 14厘米。在Aotea，请将纸张和纸板捆好，放在回收筐旁边。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Me rahi ake te pepa me te kāri papatahi i te 10 × 14 cm. Ki Aotea, paiheretia te pepa me te kāri, ka waiho ki te taha o tō pouaka hangarua."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평평한 종이와 판지는 10 × 14cm보다 커야 합니다. 아오테아에서는 종이와 판지를 묶어 재활용 상자 옆에 두세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सपाट कागज़ और कार्डबोर्ड 10 × 14 सेमी से बड़े होने चाहिए। Aotea पर इन्हें बाँधकर अपने रीसाइक्लिंग क्रेट के पास रखें।"
          }
        }
      }
    },
    "Flax, bamboo and large branches": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flax, bamboo and large branches"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亚麻、竹子和大树枝"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Harakeke, kakaho, manga rahi hoki"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아마, 대나무, 굵은 가지"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ्लैक्स, बाँस और बड़ी शाखाएँ"
          }
        }
      }
    },
    "Follow your property's collection time and placement instructions. Shared bins and apartments may have different arrangements.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow your property's collection time and placement instructions. Shared bins and apartments may have different arrangements."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请遵守您所在房产的收集时间和摆放说明。共用垃圾桶和公寓的安排可能不同。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whaia ngā tohutohu mō te wā kohinga me te wāhi whakatakoto o tō whare. He whakaritenga rerekē pea mō ngā ipu tiritahi me ngā whare noho."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 건물의 수거 시간과 배출 위치 안내를 따르세요. 공동 쓰레기통과 아파트는 방식이 다를 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी संपत्ति के संग्रह समय और सामान रखने के निर्देशों का पालन करें। साझा डिब्बों और अपार्टमेंट की व्यवस्था अलग हो सकती है।"
          }
        }
      }
    },
    "Food and Garden Waste": {
