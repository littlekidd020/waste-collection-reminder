            "state": "translated",
            "value": "Kua whakatārewatia ngā whakamaharatanga tae noa ki %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@까지 알림 일시중지됨"
          }
        },
