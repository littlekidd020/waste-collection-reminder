          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ तक अनुस्मारक निर्धारित हैं"
          }
        }
      }
    },
    "Remove all lids and put them in the rubbish.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove all lids and put them in the rubbish."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取下所有盖子并放入普通垃圾桶。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangohia ngā taupoki katoa, ka maka ki te para."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뚜껑을 모두 분리하여 일반 쓰레기로 버리세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी ढक्कन हटाकर सामान्य कचरे में डालें।"
          }
        }
      }
    },
    "Remove batteries from devices. Keep access clear and follow the date and placement instructions in your booking.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove batteries from devices. Keep access clear and follow the date and placement instructions in your booking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从设备中取出电池。保持通道畅通，并遵守预约中的日期和摆放说明。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangohia ngā pūhiko i ngā taputapu. Me wātea te ara, ā, whaia ngā tohutohu rā me te wāhi whakatakoto i tō tāpuitanga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 배터리를 제거하세요. 통로를 비워 두고 예약에 안내된 날짜와 배출 위치를 따르세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपकरणों से बैटरियाँ निकालें। रास्ता खाली रखें और बुकिंग में दी गई तारीख तथा सामान रखने के निर्देशों का पालन करें।"
          }
        }
      }
    },
