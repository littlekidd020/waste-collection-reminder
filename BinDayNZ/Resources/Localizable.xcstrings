    "%@ bin out tonight!": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今晚把%@推出去！"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज रात %@ डिब्बा बाहर निकालें!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 밤 %@ 쓰레기통을 내놓으세요!"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukua tō ipu %@ ki waho i te pō nei!"
          }
        }
      }
    },
    "Your %@ bin is collected tomorrow.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的%@将于明天被收走。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका %@ डिब्बा कल एकत्र किया जाएगा।"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일은 %@ 수거일입니다."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka kohia tō ipu %@ āpōpō."
          }
        }
      }
    },
    "%@ day today!": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天是%@日！"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज %@ दिवस है!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 %@ 수거일입니다!"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko te rā %@ tēnei rā!"
          }
        }
      }
    },
    "Don't forget your %@ bin — collection is today.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别忘了您的%@——今天是收集日。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना %@ डिब्बा बाहर रखना न भूलें — आज संग्रह का दिन है।"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 %@ 쓰레기통을 내놓는 것을 잊지 마세요."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaua e wareware ki tō ipu %@ — kei tēnei rā te kohinga."
          }
        }
      }
    }
  },
  "version": "1.1"
}