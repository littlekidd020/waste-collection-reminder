{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "comment": "Interpolation only; keep the placeholder unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@ bins": {
      "comment": "VoiceOver label of the bin picture: %@ is the bin list, e.g. 'Recycling, rubbish and food scraps bins'.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bins"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@垃圾桶"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngā ipu %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 쓰레기통"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के डिब्बे"
          }
        }
      }
    },
    "%@ is %@. Collections that week may change. Check the %@ notice before putting bins out.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is %@. Collections that week may change. Check the %@ notice before putting bins out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@是%@。那一周的收集可能有变动。放出垃圾桶前请查看%@的通知。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko %@ te %@. Ka rerekē pea ngā kohinga o taua wiki. Tirohia te pānui a %@ i mua i te tuku i ō ipu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) %@입니다. 그 주의 수거가 바뀔 수 있습니다. 쓰레기통을 내놓기 전에 %@ 안내를 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ को है। उस सप्ताह संग्रह बदल सकता है। डिब्बे बाहर रखने से पहले %@ की सूचना देखें।"
          }
        }
      }
    },
    "%@ is %@: collections that week may change.": {
      "comment": "Schedule tab, holiday line for councils without a verified holiday rule. First %@ is the public holiday's name, second is its date (e.g. 'Monday 28 December').",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is %@: collections that week may change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@是%@：那一周的收集可能有变动。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko %@ te %@: ka rerekē pea ngā kohinga o taua wiki."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(%@): 그 주의 수거가 바뀔 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ को है: उस सप्ताह संग्रह बदल सकता है।"
          }
        }
      }
    },
    "%@ on %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：%@"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ i te %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        }
      }
    },
    "%@ · %@": {
      "comment": "Small uppercase eyebrow above a bin's name on the Guide: frequency, then weekday (e.g. 'Weekly · Tuesday'). First %@ is 'Weekly' or 'Fortnightly', second is the weekday name",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@·%@"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%@, page %lld of %lld": {
      "comment": "VoiceOver label of the Guide's page indicator (lid spheres): bin name, current page number, page count. e.g. 'Rubbish, page 1 of 4'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, page %lld of %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，第 %lld 页，共 %lld 页"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, whārangi %lld o %lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %lld/%lld페이지"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, पृष्ठ %lld / %lld"
          }
        }
      }
    },
    "%@. Bring them in once they are emptied.": {
      "comment": "Sentence on the afternoon of collection day: %@ is the bin list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Bring them in once they are emptied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。清空后请收回。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Kawea mai ki roto ina whakawāteatia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 비워지면 들여놓으세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@। खाली होने के बाद इन्हें अंदर ले आएँ।"
          }
        }
      }
    },
    "%@. Have them out early.": {
      "comment": "Sentence on the morning of collection day: %@ is the bin list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Have them out early."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。请一早推出去。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Whakaputaina i te ata tū."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 아침 일찍 내놓으세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@। इन्हें सुबह जल्दी बाहर रखें।"
          }
        }
      }
    },
    "%@. Put them out tonight.": {
      "comment": "Sentence under the verdict the day before: %@ is the bin list, e.g. 'Recycling, rubbish and food scraps'.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Put them out tonight."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。今晚请推出去。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Whakaputaina i tēnei pō."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 오늘 밤 내놓으세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@। आज रात इन्हें बाहर रखें।"
          }
        }
      }
    },
    "%@: every %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: every %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：每%@"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ia %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 매주 %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: हर %@"
          }
        }
      }
    },
    "%@: every second %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: every second %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：每两周的%@"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ia rua wiki, i te %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 격주 %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: हर दूसरे %@"
          }
        }
      }
    },
    "%@: every second %@, next %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: every second %@, next %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：每两周的%@，下次 %@"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ia rua wiki, i te %@, ko te %@ e whai ake nei"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 격주 %@, 다음은 %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: हर दूसरे %@, अगली बार %@"
          }
        }
      }
    },
    "%d bins": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d bins"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 个垃圾桶"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "%d ngā ipu para"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰레기통 %d개"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%d डिब्बे"
          }
        }
      }
    },
    "A bring-in reminder and a pause while you are away are optional in Settings. A pause silences reminders only; your dates stay the same.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bring-in reminder and a pause while you are away are optional in Settings. A pause silences reminders only; your dates stay the same."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收回垃圾桶提醒和外出暂停均为可选功能，可在“设置”中开启。暂停只会停止发送提醒；您的收集日期保持不变。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "He kōwhiringa i Ngā Tautuhinga te whakamaumahara kawe mai me te whakatārewa i a koe e ngaro ana. Ka whakawahangū noa te whakatārewa i ngā whakamaumahara; ka mau tonu ō rā."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들여놓기 알림과 부재 중 일시중지는 설정에서 선택할 수 있습니다. 일시중지는 알림만 끄며 날짜는 그대로입니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिब्बे अंदर लाने का रिमाइंडर और बाहर रहने के दौरान रिमाइंडर रोकना, दोनों सेटिंग्स में वैकल्पिक हैं। रोकने से केवल रिमाइंडर बंद होते हैं; आपकी तारीखें वही रहती हैं।"
          }
        }
      }
    },
    "A calendar update is already in progress. Please try again shortly.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calendar update is already in progress. Please try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历正在更新，请稍后重试。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kei te whakahouhia kē te maramataka. Taihoa, ka whakamātau anō."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 업데이트가 진행 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर अपडेट पहले से चल रहा है। कृपया थोड़ी देर बाद फिर कोशिश करें।"
          }
        }
      }
    },
    "A location request is already in progress.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A location request is already in progress."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在获取位置。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kei te whakahaeretia kē tētahi tono tauwāhi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 요청이 이미 진행 중입니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान का अनुरोध पहले से चल रहा है।"
          }
        }
      }
    },
    "A third reminder on collection day. Each extra reminder shortens how far ahead the batch reaches.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A third reminder on collection day. Each extra reminder shortens how far ahead the batch reaches."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收集日当天的第三条提醒。每多一条提醒，提醒能提前安排到的日期就越近。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "He whakamaumahara tuatoru i te rā kohinga. Ka whakapoto ia whakamaumahara tāpiri i te roa o te wā ka whakaritea ki mua."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수거일의 세 번째 알림입니다. 알림을 추가할수록 미리 예약되는 기간이 짧아집니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संग्रह के दिन तीसरा रिमाइंडर। हर अतिरिक्त रिमाइंडर से रिमाइंडर कम समय आगे तक निर्धारित हो पाते हैं।"
          }
        }
      }
    },
    "A writable Bin Day NZ calendar could not be created or opened. Check your Calendar accounts and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A writable Bin Day NZ calendar could not be created or opened. Check your Calendar accounts and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建或打开可写入的 Bin Day NZ 日历。请检查日历账号后重试。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāore i taea te waihanga, te huaki rānei i tētahi maramataka Bin Day NZ ka taea te tuhi. Tirohia ō pūkete Maramataka, ka whakamātau anō."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 가능한 Bin Day NZ 캘린더를 만들거나 열 수 없습니다. 캘린더 계정을 확인하고 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिखने योग्य Bin Day NZ कैलेंडर बनाया या खोला नहीं जा सका। अपने कैलेंडर खाते जाँचें और फिर कोशिश करें।"
          }
        }
      }
    },
    "About": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
