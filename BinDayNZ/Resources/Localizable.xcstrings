    },
    "Confirm a collection schedule to see your next bin day.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm a collection schedule to see your next bin day."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认收集安排后，即可查看下一次收集日。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whakaūngia he hōtaka kohinga kia kite ai i tō rā kohinga para e whai ake nei."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수거 일정을 확인하면 다음 수거일을 볼 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगला कचरा संग्रह दिन देखने के लिए संग्रह कार्यक्रम की पुष्टि करें।"
