            "value": "%@ से तारीखें जाँचें"
          }
        }
      }
    },
    "Check each bin's collection date and frequency before saving.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check each bin's collection date and frequency before saving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存前，请核对每种垃圾桶的收集日期和频率。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirohia te rā me te auautanga kohinga o ia ipu i mua i te tiaki."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하기 전에 각 쓰레기통의 수거일과 주기를 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजने से पहले हर डिब्बे की संग्रह तारीख और आवृत्ति जाँचें।"
          }
        }
      }
    },
    "Check the regular collection dates for your property, then set each bin below. Add holiday or disruption changes separately.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the regular collection dates for your property, then set each bin below. Add holiday or disruption changes separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请查看您房产的常规收集日期，再设置下方各类垃圾桶。节假日或服务中断造成的变更请另行添加。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirohia ngā rā kohinga auau mō tō whare, kātahi ka tautuhi i ia ipu i raro. Tāpirihia motuhaketia ngā panonitanga hararei, raruraru ratonga rānei."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 주소의 정기 수거일을 확인한 뒤 아래에서 각 쓰레기통을 설정하세요. 공휴일이나 서비스 중단으로 인한 변경은 별도로 추가하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी संपत्ति की नियमित संग्रह तारीखें जाँचें, फिर नीचे हर डिब्बा सेट करें। छुट्टी या सेवा में बाधा के बदलाव अलग से जोड़ें।"
          }
        }
      }
    },
