    "Saved calendar ownership could not be read. No calendar events were changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved calendar ownership could not be read. No calendar events were changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
