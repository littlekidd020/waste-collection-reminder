    "Place your bin where it won't blow away. Consider weighting the lid.": {
      "extractionState": "stale",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना बिन ऐसी जगह रखें जहाँ यह उड़ न जाए। ढक्कन पर वज़न रखने पर विचार करें।"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰레기통이 날아가지 않는 곳에 놓으세요. 뛰껍에 무게를 올려놓는 것도 좋습니다."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuhia tō ipu ki te wāhi kāore e pupuhi atu. Whakaarohia te whakateima i te taupoki."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将垃圾桶放在不会被吹走的地方，可以考虑压住盖子。"
          }
        }
      }
    },
