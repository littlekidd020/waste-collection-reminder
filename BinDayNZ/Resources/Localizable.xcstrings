    "Containers must be wider than 5 cm and smaller than 4 litres. On Aotea / Great Barrier Island, the limit is 5 litres.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Containers must be wider than 5 cm and smaller than 4 litres. On Aotea / Great Barrier Island, the limit is 5 litres."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器宽度必须大于5厘米，容量小于4升。Aotea／大屏障岛的容量上限为5升。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Me whānui ake ngā ipu i te 5 cm, ā, me iti iho i te 4 rita. Ki Aotea / Great Barrier Island, ko te paenga he 5 rita."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용기는 너비가 5cm보다 크고 용량이 4리터 미만이어야 합니다. 아오테아/그레이트 배리어섬의 용량 제한은 5리터입니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंटेनर 5 सेमी से अधिक चौड़े और 4 लीटर से छोटे होने चाहिए। Aotea / Great Barrier Island पर सीमा 5 लीटर है।"
          }
        }
      }
    },
