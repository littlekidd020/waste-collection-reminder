    "Empty and rinse containers, then place them loose in your recycling bin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty and rinse containers, then place them loose in your recycling bin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倒空并冲洗容器后，散放进回收桶，不要装袋。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whakaputua, horoia hoki ngā ipu, kātahi ka waiho takitahi ki roto i tō ipu hangarua, kaua ki roto pēke."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용기를 비우고 헹군 뒤 봉투에 넣지 말고 재활용 쓰레기통에 그대로 넣으세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंटेनर खाली करके धो लें, फिर उन्हें बिना थैली के रीसाइक्लिंग डिब्बे में डालें।"
          }
        }
      }
    },
