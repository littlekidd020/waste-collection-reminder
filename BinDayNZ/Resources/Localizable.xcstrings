    "Open Bin Day NZ to schedule more reminders and check for collection changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Bin Day NZ to schedule more reminders and check for collection changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Bin Day NZ，以安排更多提醒并检查收集变更。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huakina a Bin Day NZ hei whakarite i ētahi atu whakamaharatanga, hei tirotiro hoki i ngā panonitanga kohinga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bin Day NZ를 열어 추가 알림을 예약하고 수거 변경사항을 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "और अनुस्मारक निर्धारित करने तथा संग्रह में बदलाव जाँचने के लिए Bin Day NZ खोलें।"
          }
        }
      }
    },
