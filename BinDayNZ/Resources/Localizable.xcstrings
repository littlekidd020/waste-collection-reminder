    "Chatham Islands time is 45 minutes ahead. Reminder times follow mainland New Zealand time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatham Islands time is 45 minutes ahead. Reminder times follow mainland New Zealand time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查塔姆群岛时间快45分钟。提醒时间按新西兰本土时间。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "He 45 meneti i mua te wā o Rēkohu. Ka whai ngā wā whakamaumahara i te wā o te tuawhenua o Aotearoa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채텀 제도 시간은 45분 빠릅니다. 알림 시간은 뉴질랜드 본토 시간을 따릅니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैथम द्वीप का समय 45 मिनट आगे है। रिमाइंडर समय न्यूज़ीलैंड मुख्यभूमि के समय के अनुसार होता है।"
          }
        }
      }
    },
    "Check dates with %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check dates with %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向%@核对日期"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirohia ngā rā ki %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
