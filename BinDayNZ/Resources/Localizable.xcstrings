        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app regularly to keep upcoming reminders scheduled. Delivery also depends on your device's notification settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请定期打开应用，以持续安排后续提醒。提醒是否送达也取决于设备的通知设置。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huakina te taupānga i ia wā kia whakaritea tonutia ai ngā whakamaharatanga e tū mai nei. Ka whakawhirinaki hoki te tukunga ki ngā tautuhinga whakamōhiotanga o tō pūrere."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로의 알림이 계속 예약되도록 앱을 정기적으로 여세요. 알림 전달은 기기의 알림 설정에도 영향을 받습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आने वाले अनुस्मारक निर्धारित रखने के लिए ऐप नियमित रूप से खोलें। उनकी डिलीवरी आपके डिवाइस की सूचना सेटिंग्स पर भी निर्भर करती है।"
          }
        }
      }
    },
