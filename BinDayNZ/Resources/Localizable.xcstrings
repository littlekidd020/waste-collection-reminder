    "Keep lids closed and leave footpaths, driveways and access to the bins clear.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep lids closed and leave footpaths, driveways and access to the bins clear."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请盖好桶盖，保持人行道、车道及垃圾桶周围通道畅通。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katia ngā taupoki, ā, me wātea ngā ara hīkoi, ngā ara motukā me te ara ki ngā ipu para."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뚜껑을 닫고 보도, 진입로와 쓰레기통 주변 통로를 비워 두세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ढक्कन बंद रखें और फुटपाथ, ड्राइववे तथा डिब्बों तक पहुँचने का रास्ता खाली रखें।"
          }
        }
      }
    },
    "Kerbside recycling follows national rules from 2024. Check your council for container sizes and local differences.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerbside recycling follows national rules from 2024. Check your council for container sizes and local differences."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路边回收遵循2024年起的全国规则。容器尺寸和地方差异请向议会查询。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka whai te hangarua taha huarahi i ngā ture ā-motu mai i 2024. Tirohia tō kaunihera mō ngā rahi ipu me ngā rerekētanga ā-rohe."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도로변 재활용은 2024년부터 전국 규정을 따릅니다. 용기 크기와 지역별 차이는 의회에 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सड़क किनारे रीसाइक्लिंग 2024 से राष्ट्रीय नियमों के अनुसार है। कंटेनर आकार और स्थानीय अंतर के लिए अपनी काउंसिल से जाँचें।"
          }
        }
      }
    },
