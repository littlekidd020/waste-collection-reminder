    "Address and location search": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address and location search"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址和位置搜索"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Te rapu wāhitau me te tauwāhi"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소 및 위치 검색"
          }
        },
        "hi": {
