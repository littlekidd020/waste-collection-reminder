          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kua tiakina tō hōtaka. Me tirotiro ngā whakamaharatanga: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정이 저장되었습니다. 알림 확인 필요: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका कार्यक्रम सहेज लिया गया। अनुस्मारकों पर ध्यान दें: %@"
          }
        }
      }
    },
    "Your schedule, reminder preferences, language and any saved address or map coordinates are stored on this device. Bin Day NZ does not send your saved profile to a developer-run service or sync it through iCloud.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your schedule, reminder preferences, language and any saved address or map coordinates are stored on this device. Bin Day NZ does not send your saved profile to a developer-run service or sync it through iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的收集安排、提醒偏好、语言以及保存的地址或地图坐标均存储在此设备上。Bin Day NZ 不会将这些资料发送至开发者运营的服务，也不会通过 iCloud 同步。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kei tēnei pūrere tō hōtaka, ngā kōwhiringa whakamahara, te reo me ngā wāhitau, taunga mahere rānei kua tiakina. Kāore a Bin Day NZ e tuku i tō kōtaha kua tiakina ki tētahi ratonga nā te kaiwhakawhanake, e tukutahi rānei mā iCloud."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수거 일정, 알림 환경설정, 언어와 저장된 주소 또는 지도 좌표는 이 기기에 저장됩니다. Bin Day NZ는 저장된 프로필을 개발자가 운영하는 서비스로 전송하거나 iCloud로 동기화하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका कार्यक्रम, अनुस्मारक प्राथमिकताएँ, भाषा और सहेजा गया पता या मानचित्र निर्देशांक इसी डिवाइस पर रहते हैं। Bin Day NZ आपकी सहेजी हुई प्रोफ़ाइल डेवलपर द्वारा संचालित सेवा को नहीं भेजता और न ही iCloud से सिंक करता है।"
          }
        }
      }
    },
    "Your settings could not be saved. Please try again.": {
      "extractionState": "stale",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सेटिंग्स सेव नहीं हो सकीं। कृपया फिर कोशिश करें।"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 저장할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāore i taea te tiaki ō tautuhinga. Ngana anō."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存设置，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings could not be saved. Please try again."
          }
        }
      }
    },
