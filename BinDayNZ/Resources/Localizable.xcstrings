    "The address could not be found. Enter it yourself or continue without one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address could not be found. Enter it yourself or continue without one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到该地址。请手动输入，或不填写地址继续。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāore i kitea te wāhitau. Tāurutia e koe, haere tonu rānei me te kore wāhitau."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소를 찾을 수 없습니다. 직접 입력하거나 주소 없이 계속하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पता नहीं मिला। इसे स्वयं दर्ज करें या बिना पते के आगे बढ़ें।"
          }
        }
      }
    },
    "The calendar file could not be created. Please try again.": {
      "extractionState": "stale",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर फ़ाइल बनाई नहीं जा सकी। कृपया फिर कोशिश करें।"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 파일을 만들 수 없습니다. 다시 시도해 주세요."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāore i taea te waihanga te kōnae maramataka. Ngana anō."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建日历文件，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calendar file could not be created. Please try again."
          }
        }
      }
    },
    "The collection schedule or reminder time is invalid. Check your schedule and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The collection schedule or reminder time is invalid. Check your schedule and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收集安排或提醒时间无效。请检查后重试。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "He muhu te hōtaka kohinga, te wā whakamahara rānei. Tirohia tō hōtaka, ka whakamātau anō."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수거 일정 또는 알림 시간이 유효하지 않습니다. 일정을 확인하고 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संग्रह कार्यक्रम या अनुस्मारक समय अमान्य है। अपना कार्यक्रम जाँचें और फिर कोशिश करें।"
          }
        }
      }
    },
    "The home screen widget shares collection dates and your chosen language with the app. It does not need your home address.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The home screen widget shares collection dates and your chosen language with the app. It does not need your home address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主屏幕小组件与应用共享收集日期和您选择的语言，无需您的家庭住址。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka tiri te widgiti mata kāinga i ngā rā kohinga me tō reo i kōwhiria ki te taupānga. Kāore e hiahiatia tō wāhitau kāinga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면 위젯은 수거 날짜와 선택한 언어를 앱과 공유합니다. 집 주소는 필요하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होम स्क्रीन विजेट संग्रह की तारीखें और आपकी चुनी हुई भाषा ऐप के साथ साझा करता है। इसे आपके घर के पते की ज़रूरत नहीं है।"
          }
        }
      }
    },
    "The latest reminder status could not be saved. Open the app to try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest reminder status could not be saved. Open the app to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存最新提醒状态。请打开应用重试。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāore i taea te tiaki te tūnga whakamahara hou. Huakina te taupānga hei whakamātau anō."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 알림 상태를 저장하지 못했습니다. 앱을 열어 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुस्मारक की नवीनतम स्थिति सहेजी नहीं जा सकी। फिर कोशिश करने के लिए ऐप खोलें।"
          }
        }
      }
    },
    "The next fortnight": {
      "comment": "Schedule tab: small uppercase label at the top, above the scrolling strip of the next fourteen days.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next fortnight"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来两周"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngā wiki e rua e whai ake nei"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 2주"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगले दो सप्ताह"
          }
        }
      }
    },
    "The video could not load. Check your connection, retry, or read the guide above.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video could not load. Check your connection, retry, or read the guide above."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频无法加载。请检查网络后重试，或阅读上方指南。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāore i taea te uta i te ataata. Tirohia tō hononga, whakamātauria anō, pānuitia rānei te aratohu i runga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상을 불러올 수 없습니다. 연결을 확인하고 다시 시도하거나 위의 안내를 읽으세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो लोड नहीं हो सका। अपना कनेक्शन जाँचें, फिर कोशिश करें या ऊपर दी गई गाइड पढ़ें।"
          }
        }
      }
    },
    "Then %@: %@.": {
      "comment": "Muted line under the bins about the collection after the next: first %@ a full date such as 'Tuesday 17 November', second the bin list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then %@: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后%@：%@。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kātahi ko te %@: %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그다음 %@: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर %@: %@।"
          }
        }
      }
    },
    "These are common examples. Check the council source for unusual items or changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are common examples. Check the council source for unusual items or changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是常见示例。特殊物品或规定变更，请查阅市议会信息。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "He tauira noa ēnei. Tirohia te puna kaunihera mō ngā taonga rerekē, mō ngā panonitanga rānei."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반적인 예시입니다. 특이한 품목이나 변경사항은 시의회 자료를 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये सामान्य उदाहरण हैं। असामान्य सामान या बदलावों के लिए काउंसिल की जानकारी जाँचें।"
          }
        }
      }
    },
    "They are at the kerb. Reminders for this collection are off.": {
      "comment": "Sentence after the bins were marked as out at the kerb; the app has cancelled this collection's reminders.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are at the kerb. Reminders for this collection are off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾桶已在路边。本次收集的提醒已关闭。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kei te taha huarahi ngā ipu. Kua weto ngā whakamaharatanga mō tēnei kohinga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰레기통을 도로변에 내놓았습니다. 이번 수거 알림은 꺼졌습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिब्बे सड़क किनारे हैं। इस संग्रह के अनुस्मारक बंद हैं।"
          }
        }
      }
    },
    "This removes your saved address, schedule, app reminders and calendar events created by this version. Other calendar events and exported copies are kept. You will return to setup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes your saved address, schedule, app reminders and calendar events created by this version. Other calendar events and exported copies are kept. You will return to setup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除您保存的地址、收集安排、应用提醒及此版本创建的日历事件。其他日历事件和已导出的副本会保留。您将返回初始设置。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka tangohia tō wāhitau, hōtaka, whakamaharatanga taupānga me ngā takahanga maramataka i waihangatia e tēnei putanga. Ka puritia ētahi atu takahanga maramataka me ngā tārua kua kaweake. Ka hoki koe ki te tatūnga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 주소, 수거 일정, 앱 알림과 이 버전에서 만든 캘린더 일정이 삭제됩니다. 다른 캘린더 일정과 내보낸 사본은 유지됩니다. 초기 설정 화면으로 돌아갑니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आपका सहेजा हुआ पता, कार्यक्रम, ऐप के अनुस्मारक और इस संस्करण द्वारा बनाए गए कैलेंडर इवेंट हट जाएँगे। अन्य कैलेंडर इवेंट और निर्यात की गई प्रतियाँ रहेंगी। आप सेटअप पर लौट जाएँगे।"
          }
        }
      }
    },
    "Timber under two metres, with no exposed nails": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timber under two metres, with no exposed nails"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长度小于2米、无外露钉子的木材"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "He rākau hanga kei raro i te rua mita, kāore he nēra e puta ana"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길이 2m 미만이며 못이 튀어나오지 않은 목재"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो मीटर से कम लंबी लकड़ी, जिसमें कीलें बाहर न निकली हों"
          }
        }
      }
    },
