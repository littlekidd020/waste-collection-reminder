    "Dates and reminder times use New Zealand time. Address search does not verify collection dates.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates and reminder times use New Zealand time. Address search does not verify collection dates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期和提醒时间使用新西兰时间。地址搜索不会核实收集日期。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka whakamahi ngā rā me ngā wā whakamaumahara i te wā o Aotearoa. Kāore te rapu wāhitau e whakaū i ngā rā kohinga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜와 알림 시간은 뉴질랜드 시간을 사용합니다. 주소 검색은 수거 날짜를 확인하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तारीखें और रिमाइंडर समय न्यूज़ीलैंड समय का उपयोग करते हैं। पता खोज संग्रह तारीखों की पुष्टि नहीं करती।"
          }
        }
      }
    },
    "Dates follow your saved schedule. Add any council-confirmed changes in Change schedule.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates follow your saved schedule. Add any council-confirmed changes in Change schedule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期按您保存的安排显示。如市议会确认有变更，请在“更改收集安排”中添加。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka whai ngā rā i tō hōtaka kua tiakina. Tāpirihia ngā panonitanga kua whakaūngia e te kaunihera ki Hurihia te hōtaka kohinga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜는 저장된 일정을 따릅니다. 시의회에서 확인한 변경사항은 ‘일정 변경’에 추가하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तारीखें आपके सहेजे हुए कार्यक्रम के अनुसार हैं। काउंसिल द्वारा पुष्टि किए गए बदलाव ‘संग्रह कार्यक्रम बदलें’ में जोड़ें।"
          }
        }
      }
    },
