      }
    },
    "Use Remove saved data in Settings to review and clear the app's saved information.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Remove saved data in Settings to review and clear the app's saved information."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用设置中的“删除已保存的数据”，查看并清除应用保存的信息。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whakamahia a Tangohia ngā raraunga kua tiakina i Ngā Tautuhinga hei tirotiro, hei muku hoki i ngā mōhiohio kua tiakina e te taupānga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정의 ‘저장된 데이터 삭제’에서 앱에 저장된 정보를 확인하고 지울 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप की सहेजी हुई जानकारी की समीक्षा करने और उसे साफ़ करने के लिए सेटिंग्स में ‘सहेजा गया डेटा हटाएँ’ का उपयोग करें।"
          }
        }
      }
    },
    "Use a certified home-compostable bin liner, newspaper or a paper bag if you need a liner. Compostable food packaging is not accepted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a certified home-compostable bin liner, newspaper or a paper bag if you need a liner. Compostable food packaging is not accepted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需内衬，可使用经认证可家庭堆肥的袋子、报纸或纸袋。不接受可堆肥食品包装。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki te hiahia pēke koe, whakamahia he pēke kua whakamanatia mō te wairākau ā-kāinga, he niupepa, he pēke pepa rānei. Kāore e whakaaetia ngā tākai kai ka taea te whakawairākau."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깔개나 봉투가 필요하면 가정용 퇴비화 인증 봉투, 신문지 또는 종이봉투를 사용하세요. 퇴비화 가능한 식품 포장재는 허용되지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि डिब्बे में थैली चाहिए, तो प्रमाणित घरेलू कम्पोस्ट योग्य थैली, अख़बार या कागज़ की थैली इस्तेमाल करें। कम्पोस्ट योग्य खाद्य पैकेजिंग स्वीकार नहीं की जाती।"
          }
        }
      }
    },
    "Use current location": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use current location"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前位置"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whakamahia te tauwāhi o nāianei"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치 사용"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान स्थान का उपयोग करें"
          }
        }
      }
    },
    "Use your food scraps or organics service where it is available. Check your property's collection instructions for exceptions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your food scraps or organics service where it is available. Check your property's collection instructions for exceptions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如您所在地区提供厨余或有机垃圾收集服务，请使用该服务。请查看您房产的收集说明，了解例外情况。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whakamahia te ratonga rukenga kai, para rauropi rānei ki ngā wāhi e wātea ana. Tirohia ngā tohutohu kohinga mō tō whare mō ngā aweretanga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음식물 또는 유기물 쓰레기 수거 서비스가 제공되는 지역에서는 해당 서비스를 이용하세요. 예외사항은 해당 건물의 수거 안내를 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जहाँ उपलब्ध हो, भोजन के अवशेषों या जैविक कचरे की संग्रह सेवा का उपयोग करें। अपवादों के लिए अपनी संपत्ति के संग्रह निर्देश जाँचें।"
          }
        }
      }
    },
    "Use your food scraps service where it is available. Check your property's collection instructions for exceptions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your food scraps service where it is available. Check your property's collection instructions for exceptions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如您所在地区提供厨余收集服务，请使用该服务。请查看您房产的收集说明，了解例外情况。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whakamahia te ratonga rukenga kai ki ngā wāhi e wātea ana. Tirohia ngā tohutohu kohinga mō tō whare mō ngā aweretanga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음식물 쓰레기 수거 서비스가 제공되는 지역에서는 해당 서비스를 이용하세요. 예외사항은 해당 건물의 수거 안내를 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जहाँ उपलब्ध हो, भोजन के अवशेषों की संग्रह सेवा का उपयोग करें। अपवादों के लिए अपनी संपत्ति के संग्रह निर्देश जाँचें।"
          }
        }
      }
    },
    "User-confirmed schedule": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User-confirmed schedule"
          }
        },
        "zh-Hans": {
