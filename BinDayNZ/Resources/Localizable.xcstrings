    "To avoid duplicate alerts, turn off app notifications if you use calendar alerts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To avoid duplicate alerts, turn off app notifications if you use calendar alerts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为避免重复提醒，如果您使用日历提醒，请关闭应用通知。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kia kore ai e tāruarua ngā whakaoho, whakawetohia ngā pānui taupānga mēnā ka whakamahi koe i ngā whakaoho maramataka."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 중복되지 않도록 캘린더 알림을 사용하는 경우 앱 알림을 끄세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहरे अलर्ट से बचने के लिए, यदि आप कैलेंडर अलर्ट का उपयोग करते हैं तो ऐप सूचनाएँ बंद कर दें।"
          }
        }
      }
    },
    "Collection day": {
