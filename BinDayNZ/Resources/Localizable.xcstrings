    "Saved data could not be removed. Free some device storage and try again. Your schedule has been kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved data could not be removed. Free some device storage and try again. Your schedule has been kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除已保存的数据。请释放一些设备存储空间后重试。您的收集安排已保留。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāore i taea te tango ngā raraunga kua tiakina. Whakawāteatia ētahi wāhi rokiroki, ka whakamātau anō. Kua puritia tō hōtaka."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 데이터를 삭제하지 못했습니다. 기기 저장 공간을 확보하고 다시 시도하세요. 수거 일정은 유지되었습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा गया डेटा हटाया नहीं जा सका। डिवाइस में कुछ जगह खाली करके फिर कोशिश करें। आपका कार्यक्रम रखा गया है।"
          }
        }
      }
    },
