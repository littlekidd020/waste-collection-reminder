    "Optional. Loading a video connects to YouTube. The written guide works without an internet connection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Loading a video connects to YouTube. The written guide works without an internet connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。加载视频会连接 YouTube。文字指南无需网络即可使用。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "He kōwhiringa tēnei. Ka tūhono te uta ataata ki YouTube. Ka taea te pānui i te aratohu ā-tuhi me te kore hononga ipurangi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항입니다. 동영상을 불러오면 YouTube에 연결됩니다. 글로 된 안내는 인터넷 연결 없이 볼 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। वीडियो लोड करने पर YouTube से कनेक्शन बनता है। लिखित गाइड इंटरनेट कनेक्शन के बिना काम करती है।"
          }
        }
      }
    },
