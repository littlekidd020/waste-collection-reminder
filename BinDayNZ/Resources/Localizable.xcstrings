    "See your next collection without opening the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your next collection without opening the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需打开应用即可查看下一次收集。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirohia tō kohinga e whai ake nei me te kore e whakatuwhera i te taupānga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열지 않고도 다음 수거일을 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप खोले बिना अपना अगला संग्रह देखें।"
          }
        }
      }
    },
    "Touch and hold your Home Screen, tap the plus button, then search for Bin Day NZ.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold your Home Screen, tap the plus button, then search for Bin Day NZ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按主屏幕，点按加号按钮，然后搜索 Bin Day NZ。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pēhia kia roa tō Mata Kāinga, pāwhiria te pātene tāpiri, kātahi ka rapu i a Bin Day NZ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면을 길게 누르고 더하기 버튼을 탭한 다음 Bin Day NZ를 검색하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी होम स्क्रीन को देर तक दबाएँ, प्लस बटन टैप करें, फिर Bin Day NZ खोजें।"
          }
        }
      }
    },
    "Share with your household": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share with your household"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享给家人"
          }
