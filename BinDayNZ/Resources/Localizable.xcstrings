        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिब्बे के नियमित चक्र में मूल तारीख और ऐसी नई तारीख चुनें जिस पर कोई अन्य संग्रह न हो।"
          }
        }
      }
    },
