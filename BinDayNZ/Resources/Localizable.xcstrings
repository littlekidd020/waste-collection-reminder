    },
    "Reminders are scheduled on your device and depend on notification permission and your system settings. You can change them in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders are scheduled on your device and depend on notification permission and your system settings. You can change them in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒在您的设备上安排，取决于通知权限和系统设置。您可以在设置中更改。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka whakaritea ngā whakamaharatanga ki tō pūrere, ā, ka whakawhirinaki ki te whakaaetanga whakamōhiotanga me ngā tautuhinga pūnaha. Ka taea te huri i Ngā Tautuhinga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 기기에서 예약되며 알림 권한과 시스템 설정에 따라 작동합니다. 설정에서 변경할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुस्मारक आपके डिवाइस पर निर्धारित होते हैं और सूचना की अनुमति तथा सिस्टम सेटिंग्स पर निर्भर करते हैं। आप इन्हें सेटिंग्स में बदल सकते हैं।"
          }
        }
      }
    },
    "Reminders could not all be scheduled. Open the app to try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders could not all be scheduled. Open the app to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分提醒未能安排。请打开应用重试。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāore i taea te whakarite ngā whakamaharatanga katoa. Huakina te taupānga hei whakamātau anō."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 알림을 예약하지 못했습니다. 앱을 열어 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी अनुस्मारक निर्धारित नहीं हो सके। फिर कोशिश करने के लिए ऐप खोलें।"
          }
        }
      }
    },
    "Reminders on · %@": {
      "comment": "Quiet status line on Today when reminders are scheduled: %@ lists the reminder times, e.g. '7 pm and 7 am'.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders on · %@"
          }
        },
        "zh-Hans": {
