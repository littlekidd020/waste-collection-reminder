            "value": "%@ 从 %@ 改为 %@"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka neke a %@ mai i te %@ ki te %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@에서 %@(으)로 변경"
          }
        },
        "hi": {
          "stringUnit": {
