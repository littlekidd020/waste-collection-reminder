    },
    "Review this shared schedule, then confirm it matches your property.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review this shared schedule, then confirm it matches your property."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请核对这份共享日程，并确认它与您的房产相符。"
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arotakehia tēnei rārangi wā kua tohaina, kātahi ka whakaū e hāngai ana ki tōu whare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유된 일정을 검토한 후 거주지와 일치하는지 확인하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस साझा शेड्यूल की समीक्षा करें, फिर पुष्टि करें कि यह आपकी संपत्ति से मेल खाता है।"
          }
        }
      }
    },
