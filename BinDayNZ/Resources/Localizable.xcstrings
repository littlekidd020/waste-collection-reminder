          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngā mōhiohio matatapu a YouTube"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube 개인정보 안내"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube की गोपनीयता जानकारी"
          }
        }
      }
    },
    "Your bin schedule": {
      "localizations": {
        "en": {
          "stringUnit": {
